import java.util.Arrays;

class Solution {
    public int minIncrementForUnique(int[] nums) {
        if (nums == null || nums.length <= 1) {
            return 0;
        }

        // Sort the array to process elements in order
        Arrays.sort(nums);

        int moves = 0;

        for (int i = 1; i < nums.length; i++) {
            // If the current element is not strictly greater than the previous one
            if (nums[i] <= nums[i - 1]) {
                int needed = nums[i - 1] + 1;
                moves += needed - nums[i];
                nums[i] = needed; // Update current element to the new unique value
            }
        }

        return moves;
    }
}
